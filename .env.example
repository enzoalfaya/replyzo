# Copia este ficheiro para ".env" e preenche.
# Facebook: responde a comentarios. Instagram: responde a comentarios + DM.
# Podes ligar o webhook e passar a verificacao SO com META_VERIFY_TOKEN; os
# tokens/ids so sao precisos para responder de facto.

# Porta do servidor (opcional).
PORT=4300

# Senha do dashboard (/dashboard). Se deixares vazio, o servidor gera uma
# aleatoria no arranque e mostra-a no terminal. Define aqui para fixar a tua.
DASHBOARD_PASS=

# Segredo que TU inventas (qualquer texto). Tem de ser IGUAL ao "Verify token"
# que escreves no painel da Meta ao configurar o webhook.
META_VERIFY_TOKEN=

# "App secret" da tua app Meta (developers.facebook.com > Definicoes > Basico).
# Valida a assinatura dos eventos (X-Hub-Signature-256). Vazio = nao valida (dev).
META_APP_SECRET=

# Versao da Graph API (opcional). Por defeito v21.0.
META_GRAPH_VERSION=v21.0

# --- Instagram (conta Business/Creator) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Facebook (Pagina) ---
PAGE_ID=
PAGE_ACCESS_TOKEN=
